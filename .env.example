# ── Postgres ────────────────────────────────────────────────────────────
#
# Using Neon: your project's Connect page gives you two connection
# strings — grab both.
#   DATABASE_URL -> the "Pooled connection" string (host has "-pooler" in it)
#   DIRECT_URL   -> the "Direct connection" string (no "-pooler")
# The app runs on the pooled one; `prisma migrate` needs the direct one
# (schema changes require a real session, which connection pooling
# doesn't support). Both include `?sslmode=require` — keep that.
#
# Not using Neon (e.g. local Docker Postgres)? Point both at the same
# plain connection string:
#   docker run --name donor-success-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=donor_success -p 5432:5432 -d postgres:16
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/donor_success?schema=public"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/donor_success?schema=public"

DATABASE_URL=""
DIRECT_URL=""

# Auth.js reads AUTH_SECRET automatically. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Optional but recommended to set explicitly in every environment.
NEXTAUTH_URL="http://localhost:3000"

# Protects /api/cron/* routes — Vercel Cron sends this as a Bearer token.
CRON_SECRET=""

# --- Salesforce integration (Phase 1: connection only) ---
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
# SALESFORCE_LOGIN_URL="https://test.salesforce.com"

# Encrypts stored OAuth tokens at rest.
CRM_TOKEN_ENCRYPTION_KEY=""

# --- Transactional email (Resend) ---
RESEND_API_KEY=""
# EMAIL_FROM="Donor Success <noreply@donorsuccess.com>"

# --- Self-serve billing (Stripe) — Starter only ---
# Growth and Enterprise are sales-assisted and flow through TurboQuote /
# TurboSign into the internal Order & Fulfillment queue.
STRIPE_SECRET_KEY=""
# Webhook endpoint: {your-app-url}/api/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_ANNUAL=""

# Legacy Growth Stripe price IDs are retained only for compatibility with
# any older environment/configuration references. New Growth purchases must
# not use self-service checkout.
STRIPE_PRICE_GROWTH_MONTHLY=""
STRIPE_PRICE_GROWTH_ANNUAL=""

# --- TurboDocx / TurboSign sales-assisted fulfillment ---
# TurboDocx Organization Settings → API Keys / Organization ID.
TURBODOCX_API_KEY=""
TURBODOCX_ORG_ID=""
# Configure the TurboSign webhook URL as:
#   {your-app-url}/api/webhooks/turbodocx
# Subscribe initially to:
#   signature.document.completed
#   signature.document.voided
# Save the secret shown when the webhook configuration is created.
TURBODOCX_WEBHOOK_SECRET=""
# Optional sender identity for future direct TurboSign SDK calls.
TURBODOCX_SENDER_EMAIL=""

# --- File storage (Vercel Blob) — grant document attachments ---
BLOB_READ_WRITE_TOKEN=""

# --- Support chat widget (Anthropic API) ---
ANTHROPIC_API_KEY=""
# SUPPORT_CHAT_MODEL="claude-sonnet-4-6"

# --- Email integration (Gmail / Outlook, per-fundraiser) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
