# ── Postgres ────────────────────────────────────────────────────────────
#
# Using Neon: your project's Connect page gives you two connection
# strings — grab both.
#   DATABASE_URL -> the "Pooled connection" string (host has "-pooler" in it)
#   DIRECT_URL   -> the "Direct connection" string (no "-pooler")
# The app runs on the pooled one; `prisma migrate` needs the direct one
# (schema changes require a real session, which connection pooling
# doesn't support). Both include `?sslmode=require` — keep that.
#
# Not using Neon (e.g. local Docker Postgres)? Point both at the same
# plain connection string:
#   docker run --name donor-success-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=donor_success -p 5432:5432 -d postgres:16
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/donor_success?schema=public"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/donor_success?schema=public"

DATABASE_URL=""
DIRECT_URL=""

# Auth.js reads AUTH_SECRET automatically. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Optional but recommended to set explicitly in every environment.
NEXTAUTH_URL="http://localhost:3000"

# Protects /api/cron/* routes — Vercel Cron sends this as a Bearer token
# (Authorization: Bearer <value>) when it triggers scheduled jobs, so
# only Vercel's own cron infra (not a random internet request) can
# trigger a recalculation sweep. Generate the same way as AUTH_SECRET:
#   openssl rand -base64 32
# You only need this set in your Vercel project's env vars for the cron
# to actually work — locally it's unused unless you're testing the route
# by hand with `curl -H "Authorization: Bearer $CRON_SECRET" ...`.
CRON_SECRET=""

# --- Salesforce integration (Phase 1: connection only) ---
# From your Salesforce Connected App (Setup → App Manager → New
# Connected App). See README for the exact steps and required OAuth
# scopes/callback URL.
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
# Only needed if connecting a Salesforce sandbox instead of production —
# sandboxes authenticate through test.salesforce.com, not
# login.salesforce.com. Leave unset for production orgs.
# SALESFORCE_LOGIN_URL="https://test.salesforce.com"

# Encrypts stored OAuth tokens (Salesforce and any future CRM
# connections) at rest — required before any CRM connection will work.
# Generate the same way as AUTH_SECRET:
#   openssl rand -base64 32
CRM_TOKEN_ENCRYPTION_KEY=""

# --- Transactional email (Resend) ---
# From resend.com — sign up free (3,000 emails/month, no card required),
# then API Keys → Create API Key.
RESEND_API_KEY=""

# Optional. Without this, emails send from Resend's shared test address
# (onboarding@resend.dev) — works immediately with zero setup, but hurts
# deliverability at any real volume and looks unprofessional to
# customers. To use your own domain: Resend dashboard → Domains → Add
# Domain → add the DNS records they give you (SPF + DKIM) → once
# verified, set this to something like:
#   EMAIL_FROM="Donor Success <noreply@donorsuccess.com>"
# EMAIL_FROM=""

# --- Self-serve billing (Stripe) — Starter & Growth only ---
# Enterprise is sales-led and provisioned manually through the Master
# Admin Console; it never touches Stripe at all, so no Price ID exists
# for it.
#
# From your Stripe Dashboard (Developers → API keys):
STRIPE_SECRET_KEY=""
#
# Developers → Webhooks → Add endpoint, pointing at:
#   {your-app-url}/api/webhooks/stripe
# Select events: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted. After creating it, copy the "Signing secret":
STRIPE_WEBHOOK_SECRET=""
#
# Product catalog → create a Product for each plan, with a recurring
# Price for both monthly and annual billing (4 Prices total). Copy each
# Price ID (starts with "price_") below:
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_GROWTH_MONTHLY=""
STRIPE_PRICE_GROWTH_ANNUAL=""

# --- File storage (Vercel Blob) — grant document attachments ---
# Vercel Dashboard → your project → Storage → Create Database → Blob.
# IMPORTANT: choose "Private" access when creating the store — this
# can't be changed after creation. Public and private are genuinely
# different store types, not just a flag on individual files.
# Once created and connected to this project, BLOB_READ_WRITE_TOKEN is
# usually set automatically as a Vercel System Environment Variable —
# for local development, pull it down with:
#   npx vercel env pull .env.local
# If it's not set automatically, copy it manually from the Blob store's
# settings page in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=""

# --- Support chat widget (Anthropic API) ---
# console.anthropic.com → API Keys → Create Key.
# Without this set, the widget still shows and takes questions, but
# every request returns "Support chat is not configured yet." rather
# than failing in a way that looks like a crash.
ANTHROPIC_API_KEY=""
# Optional — defaults to claude-sonnet-4-6 if unset. Override only if
# you want a different model for cost or quality reasons.
# SUPPORT_CHAT_MODEL="claude-sonnet-4-6"

# --- Email integration (Gmail / Outlook, per-fundraiser) ---
# From a Google Cloud Console project (APIs & Services → Credentials →
# OAuth client ID, type "Web application"). Enable the Gmail API first.
# Callback URL to register: {your-app-url}/api/integrations/gmail/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# From an Azure App Registration (Azure Portal → App registrations →
# New registration → Certificates & secrets → New client secret). Add
# the Mail.Send and User.Read Microsoft Graph permissions.
# Callback URL to register: {your-app-url}/api/integrations/outlook/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

